# =============================================================================
# WingsDataCenter .gitignore
# Covers: UE4.27 (HTML5 custom branch), Python thermal model, VS Code, OS junk
# =============================================================================

# -----------------------------------------------------------------------------
# Unreal Engine 4 (standard Epic-recommended ignores, plus HTML5-build extras)
# -----------------------------------------------------------------------------
# Build/derived folders regenerated by the editor -- never commit these
UE4-viz/Binaries/
UE4-viz/Build/
UE4-viz/DerivedDataCache/
UE4-viz/Intermediate/
UE4-viz/Saved/
UE4-viz/.vs/

# HTML5 platform build output (regenerated on each package/export)
UE4-viz/HTML5/
UE4-viz/**/HTML5Distribution/

# Per-user project files -- machine specific, not meant to be shared
*.opensdf
*.sdf
*.sln
*.suo
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace

# Compiled binaries / packaged data that shouldn't live in source control
*.exe
*.dll
*.pak
*.ipa
*.apk

# Cache/log files UE4 regenerates constantly
*.log
*.tmp

# -----------------------------------------------------------------------------
# Python (thermal-model)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/

# -----------------------------------------------------------------------------
# CFD (SimScale / OpenFOAM local exports, if you ever export local case files)
# -----------------------------------------------------------------------------
cfd/*.foam
cfd/**/processor*/
cfd/**/postProcessing/
cfd/**/*.vtk
cfd/**/*.vtu

# -----------------------------------------------------------------------------
# VS Code
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# -----------------------------------------------------------------------------
# OS junk
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# Node (only relevant if you ever run npm/vite/etc. inside this repo)
# -----------------------------------------------------------------------------
node_modules/
